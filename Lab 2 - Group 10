        "# Create non-linear and interaction features\n",
        "X_train_complex = X_train.copy()\n",
        "X_test_complex = X_test.copy()\n",
        "\n",
        "for df in [X_train_complex, X_test_complex]:\n",
        "    df['sq_ft_squared'] = df['house_square_feet'] ** 2\n",
        "    df['bed_bath_interaction'] = df['bedrooms'] * df['bathrooms']\n",
        "\n",
        "# Fit model and evaluate\n",
        "lr_complex = LinearRegression().fit(X_train_complex, y_train_log)\n",
        "\n",
        "y_tr_pred = np.exp(lr_complex.predict(X_train_complex))\n",
        "y_te_pred = np.exp(lr_complex.predict(X_test_complex))\n",
        "\n",
        "print(f\"Complex Model (with Log target & interactions):\\n\"\n",
        "      f\"  Train - RMSE: ${np.sqrt(mean_squared_error(y_train, y_tr_pred)):,.2f}, R2: {r2_score(y_train, y_tr_pred):.4f}\\n\"\n",
