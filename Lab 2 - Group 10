        "\n",
        "# Train and evaluate models\n",
        "for name, features in models.items():\n",
        "    lr = LinearRegression().fit(X_train[features], y_train)\n",
        "\n",
        "    tr_rmse = np.sqrt(mean_squared_error(y_train, lr.predict(X_train[features])))\n",
        "    te_rmse = np.sqrt(mean_squared_error(y_test, lr.predict(X_test[features])))\n",
        "    tr_r2 = r2_score(y_train, lr.predict(X_train[features]))\n",
        "    te_r2 = r2_score(y_test, lr.predict(X_test[features]))\n",
        "\n",
        "    print(f\"{name}:\\n  Train - RMSE: ${tr_rmse:,.2f}, R2: {tr_r2:.4f}\\n  Test  - RMSE: ${te_rmse:,.2f}, R2: {te_r2:.4f}\\n\")"
